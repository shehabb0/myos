# Copy to .env locally or enter these as private environment variables on your hosting platform.
# NEVER commit a real .env or paste the Notion token into frontend code.
NOTION_TOKEN=
NOTION_VERSION=2025-09-03
# Set an app password before enabling Notion sync on a public deployment.
APP_PASSWORD=
SESSION_SECRET=
# These are Notion DATA SOURCE IDs, not database-page IDs. Find them using Notion's Connections/API.
NOTION_DAILY_SOURCE=
NOTION_EXERCISES_SOURCE=
NOTION_GOALS_SOURCE=
NOTION_TARGETS_SOURCE=
NOTION_BODY_SOURCE=
NOTION_FOODS_SOURCE=
NOTION_MEALS_SOURCE=
NOTION_PLANNER_SOURCE=
NOTION_SUPPLEMENTS_SOURCE=
PORT=3000